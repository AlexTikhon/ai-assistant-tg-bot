# Required to run the bot (TELEGRAM_BOT_TOKEN is read only by the bot itself)
# - `npm run reindex -- --dry-run`, `integrity`, `backup`, `backup:verify`, `restore`, `diagnostics`, `db:maintenance`, `smoke`, `eval:retrieval`, `test:retrieval` and `bench:retrieval` need neither
# - a real `npm run reindex` and a confirmed `npm run eval:retrieval:live -- --confirm-spend` need only OPENAI_API_KEY
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Models (defaults shown)
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# After changing the embeddings model run `npm run reindex` (see README, "Re-indexing")
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Storage (default: ./data - holds app.db and files/; the Docker image sets DATA_DIR=/data and declares it a volume)
# DATA_DIR=data

# Ingestion
# MAX_UPLOAD_BYTES=10485760
# Chunking is part of the index recipe: after changing it run `npm run reindex -- --dry-run`, then `--rechunk`
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150

# Retrieval (hybrid: vector search + SQLite FTS5, fused with reciprocal rank fusion)
# Chunks handed to the model
# RETRIEVAL_TOP_K=5
# Minimum cosine similarity for a chunk to count as a semantic candidate
# MIN_SIMILARITY_SCORE=0.2
# Depth of the two candidate lists that are fused, and the constant of reciprocal rank fusion
# (compare settings with `npm run eval:retrieval -- --compare eval/comparisons/default.json` before changing them)
# RETRIEVAL_SEMANTIC_LIMIT=20
# RETRIEVAL_LEXICAL_LIMIT=20
# RETRIEVAL_RRF_K=60
# Approximate budget (characters) for the chunk text sent to the model
# RETRIEVAL_CONTEXT_MAX_CHARS=6000
# Extra ranking evidence for chunks that contain an identifier / file name / version of the question verbatim
# (E-4012, ECONNRESET, v2.14.1, config/settings.yaml), in units of the best single-ranking contribution. 0 turns it off
# RETRIEVAL_EXACT_TOKEN_BONUS=1

# Answerability gate: when the retrieved evidence is weak the bot can answer "I couldn't find enough information" WITHOUT calling the
# chat model. Calibrated on the offline evaluation corpus (docs/evaluation.md), NOT yet on real embeddings, so it starts in shadow mode:
#   off     - no gate
#   shadow  - the decision is computed and logged ("Confidence gate shadow decision"), answers are never changed (default)
#   enforce - weak evidence gets the refusal, without calling the chat model
# The similarity threshold depends on the embedding model: re-check it with `npm run eval:confidence` (offline) and a live run.
# RETRIEVAL_CONFIDENCE_MODE=shadow
# Thumbs-up / thumbs-down buttons under answers; the rating is stored with the gate's decision, never any text (to calibrate on real use)
# FEEDBACK_BUTTONS=false
# Best cosine similarity that counts as strong semantic evidence
# RETRIEVAL_CONFIDENCE_MIN_SEMANTIC_SCORE=0.5
# Share of the question's content words one chunk must contain to count as strong lexical evidence
# RETRIEVAL_CONFIDENCE_MIN_TERM_COVERAGE=0.6

# Per-user storage limits
# MAX_DOCUMENTS_PER_USER=100
# MAX_STORAGE_BYTES_PER_USER=209715200
# MAX_CHUNKS_PER_DOCUMENT=2000
# Total indexed chunks across all of one user's documents (also enforced at publication)
# MAX_CHUNKS_PER_USER=10000
# A PDF with more pages is refused before any text is extracted (default 1000)
# MAX_PDF_PAGES=1000

# Per-user rate limit for operations that call OpenAI (questions, summaries, uploads, voice)
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_MS=60000

# Timeouts (milliseconds)
# REQUEST_TIMEOUT_MS=60000
# Whole-update deadline: aborts provider calls, stops subsequent work and suppresses late replies
# HANDLER_TIMEOUT_MS=300000

# Logging
# LOG_LEVEL=info
# Log the text of user questions (development only; off by default; the bot warns at startup when it is on)
# LOG_QUESTIONS=false
# Log how every question was retrieved: ids, ranks, counts, timings - never text (development only)
# RAG_DEBUG=false
