# Required
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Models (defaults shown)
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Storage (default: ./data - holds app.db and files/)
# DATA_DIR=data

# Ingestion
# MAX_UPLOAD_BYTES=10485760
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150

# Retrieval
# RETRIEVAL_TOP_K=5
# MIN_SIMILARITY_SCORE=0.2

# Timeouts (milliseconds)
# REQUEST_TIMEOUT_MS=60000
# HANDLER_TIMEOUT_MS=300000

# Logging
# LOG_LEVEL=info
# Log the text of user questions (development only; off by default)
# LOG_QUESTIONS=false
